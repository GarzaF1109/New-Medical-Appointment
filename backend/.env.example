# Copie este archivo a .env y ajuste los valores. NUNCA versione .env.
ENVIRONMENT=development
DEBUG=true

# SQLite para arranque rapido; PostgreSQL en docker-compose.
DATABASE_URL=sqlite+pysqlite:///./medical.db
# DATABASE_URL=postgresql+psycopg://medical:medical@localhost:5432/medical

CORS_ORIGINS=["http://localhost:5173"]

# Sin estas credenciales la app usa un notificador que solo escribe en el log.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
